OTEL_SERVICE_NAME=ai-dial-admin-evaluation-metrics
OTEL_PYTHON_LOG_CORRELATION=false
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none

LOG_LEVEL=INFO
LOG_LEVEL_OVERRIDE={"uvicorn.access":"INFO"}

# Opt out for DeepEval telemetry collection
DEEPEVAL_TELEMETRY_OPT_OUT=1

# DIAL connection for integration tests and make serve
DIAL_URL=https://your-dial-instance.example.com
DIAL_API_KEY=your-actual-api-key
